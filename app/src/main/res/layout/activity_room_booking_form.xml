<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".roomBookingForm"
    android:background="@drawable/room_booking_background"
    android:gravity="center">
    
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_effect"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room Booking"
            android:textSize="35dp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#061C6D"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please fill this with your account full name and email"
            android:textAlignment="center"
            android:textSize="20dp"
            android:textColor="#F31313"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/full_name_room_booking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:textColor="#061C6D"
            android:textColorHint="#061C6D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_corner"
            android:padding="18dp"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/email_room_booking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="#061C6D"
            android:textColorHint="#061C6D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_corner"
            android:padding="18dp"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/room_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Type (e.g., Deluxe Room, Ocean View Suit)"
            android:inputType="textMultiLine"
            android:textColor="#061C6D"
            android:textColorHint="#061C6D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_corner"
            android:padding="18dp"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/roomBookBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book"
            android:backgroundTint="@color/white"
            android:textColor="#061C6D"
            android:padding="18dp"
            android:layout_marginTop="8dp"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>