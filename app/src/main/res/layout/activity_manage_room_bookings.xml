<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".manageRoomBookings"
    android:orientation="vertical"
    android:background="@drawable/booking_details_page">

    <EditText
        android:id="@+id/bookingEmail"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:hint="Enter your account Email"
        android:textColor="#061C6D"
        android:textColorHint="#061C6D"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/background_effect"
        android:padding="18dp"
        android:layout_gravity="center"/>

    <Button
        android:id="@+id/proceedBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proceed"
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#061C6D"
        android:layout_marginTop="8dp"
        android:background="#F9F6FD"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBookingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:layout_weight="1"/>

</LinearLayout>