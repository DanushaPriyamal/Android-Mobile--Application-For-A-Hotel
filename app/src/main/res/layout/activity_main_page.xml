<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mainPage"
    android:background="@drawable/main_page_background"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/background_effect"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LuxeVista Resort"
            android:textStyle="bold"
            android:textSize="35dp"
            android:textColor="#910B94"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Manage Profile"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:layout_marginEnd="10dp"
                android:padding="10dp"
                android:onClick="manageProfileNavigation"/>

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Book Rooms"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:padding="10dp"
                android:onClick="bookRoomsNavigation"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Manage Room Bookings"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:layout_marginEnd="10dp"
                android:padding="10dp"
                android:onClick="manageRoomBookingNaviagtion"/>

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Service Reservation"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:padding="10dp"
                android:onClick="serviceReservationNavigation"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Service Reservation Calender"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:layout_marginEnd="10dp"
                android:padding="10dp"
                android:onClick="serviceReservationCalenderNavigation"/>

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Manage Service Reservation"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:padding="10dp"
                android:onClick="manageServiceReservationNavigation"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Offers And Nearby Attractions"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:layout_marginEnd="10dp"
                android:padding="10dp"
                android:onClick="offersAndNearbyAttractionsNavigation"/>

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Notifications"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:padding="10dp"
                android:onClick="notificationNavigation"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <Button
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:text="Sign Out"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="13dp"
                android:textColor="#030A23"
                android:background="#1B82E9"
                android:padding="10dp"
                android:onClick="logOutNavigation"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>